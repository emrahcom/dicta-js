{
  "name": "dicta-js",
  "version": "0.1.1",
  "description": "Browser element for text and voice input. Streams speech to dicta-server and types the words into your app.",
  "keywords": [
    "speech-to-text",
    "voice-input",
    "dictation",
    "web-components",
    "custom-elements",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emrahcom/dicta-js.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "prettier --check . && tsc",
    "format": "prettier --write .",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "node --test --test-timeout=5000 \"test/**/*.test.ts\"",
    "test:browser": "npm run build && playwright test",
    "demo": "npm run build && node demo/serve.ts",
    "prepublishOnly": "rm -rf dist && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  }
}
